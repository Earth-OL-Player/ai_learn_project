# ai-service 内部鉴权 Token 占位符，真实值需与后端配置保持一致。
AI_SERVICE_TOKEN=AI_SERVICE_TOKEN占位符
# AI 服务日志级别，生产默认 INFO；本地排查完整大模型入参和返回时可临时改为 DEBUG。
AI_SERVICE_LOG_LEVEL=INFO
# AI 评分模型服务基础地址占位符，OpenAI 兼容服务通常填写到 /v1。
AI_GRADING_BASE_URL=https://模型服务地址占位符/v1
# AI 评分模型 API Key 占位符，真实值禁止提交仓库。
AI_GRADING_API_KEY=AI_GRADING_API_KEY占位符
# AI 评分模型名称，LOCAL_RULE 表示 ai-service 不发起外部模型请求。
AI_GRADING_MODEL=LOCAL_RULE
# AI 评分模型供应商标识，留空时由 LangChain 按模型名推断。
AI_GRADING_MODEL_PROVIDER=
# AI 评分模型调用超时时间，单位为秒。
AI_GRADING_TIMEOUT_SECONDS=20
# AI 评分模型单次回复最大输出 Token 数，真实环境可按模型成本和答案长度调整。
AI_GRADING_MAX_OUTPUT_TOKENS=600
