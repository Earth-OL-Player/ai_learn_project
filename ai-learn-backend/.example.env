# MySQL 业务主库，本地真实账号密码请写入私有 .env 或环境变量，禁止提交真实值。
DATABASE_URL=jdbc:mysql://127.0.0.1:3306/ai_learn?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
# MySQL 登录用户名占位符，请按本地业务账号替换。
DATABASE_USERNAME=本地MySQL用户名占位符
# MySQL 登录密码占位符，真实密码只能放在本地私有配置中。
DATABASE_PASSWORD=本地MySQL密码占位符
# Flyway 开关，用于控制后端启动时是否自动执行数据库迁移。
SPRING_FLYWAY_ENABLED=true

# JWT 签名密钥请使用至少 32 位随机字符串，真实值只能放在本地或服务器私有配置中。
JWT_SECRET=至少32位本地JWT密钥占位符
# JWT 过期秒数，用于控制登录令牌有效期。
JWT_EXPIRES_IN_SECONDS=7200

# AI 服务配置；启用时 token 必须与 ai-service/.env 保持一致。
AI_SERVICE_ENABLED=true
# AI 服务基础地址，用于后端访问本地或部署后的 ai-service。
AI_SERVICE_BASE_URL=http://127.0.0.1:8000
# AI 服务内部鉴权 Token 占位符，真实值需与 ai-service 保持一致。
AI_SERVICE_TOKEN=AI_SERVICE_TOKEN本地占位符
# AI 服务调用超时时间，单位为秒。
AI_SERVICE_TIMEOUT_SECONDS=15

# 高级模型授权地址：必须填写包含 http:// 或 https:// 的完整网站地址。
MODEL_AUTHORIZATION_URL=https://www.baidu.com
